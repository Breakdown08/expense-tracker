# cp .env.example .env, fill in, then `docker compose up -d`.

# --- Required ---
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user ids allowed to use the bot (ask @userinfobot). Everyone else is ignored.
ALLOWED_USER_IDS=
# provider:model for LangChain init_chat_model. Groq's free tier runs it without a card.
LLM_MODEL=groq:openai/gpt-oss-120b
# Key of the provider in LLM_MODEL: https://console.groq.com/keys
GROQ_API_KEY=
# Instead of Groq: LLM_MODEL=anthropic:claude-haiku-5-5
# ANTHROPIC_API_KEY=

# --- Optional: publishing. A platform without keys gets the post as text to publish by hand. ---
# Threads: Meta app with threads_basic + threads_content_publish.
# THREADS_ACCESS_TOKEN=
# THREADS_USER_ID=
# Telegram channel where the bot is an admin allowed to post: @name or -100... id.
# TELEGRAM_CHANNEL_ID=

# Day boundary for expenses without a date.
# TIMEZONE=Asia/Ho_Chi_Minh

# --- Optional: database (defaults suit docker compose) ---
# POSTGRES_PASSWORD=tracker
# POSTGRES_PORT=5432
